{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/meteo-cron?slot=00",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=02",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=04",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=06",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=08",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=10",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=12",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=14",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=16",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=18",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=20",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/meteo-cron?slot=22",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://*.public.blob.vercel-storage.com data: blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://api.open-meteo.com https://cdn.jsdelivr.net; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
